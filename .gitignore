# CleanX — ignores racine (s'ajoutent à app/.gitignore et windows/.gitignore)
# Build Rust (régénérable : cargo build)
core/target/
core/fuzz/target/
# Build Flutter (régénérable : flutter build)
app/build/
# Outillage Dart/Flutter
app/.dart_tool/
app/.flutter-plugins*
# Logs et temporaires
*.log
.DS_Store
Thumbs.db
# Clés et bases LOCALES d'exécution (jamais versionnées)
cle.key
*.db
*.db-journal
# Dossier de quarantaine RUNTIME à la racine uniquement (ne pas confondre
# avec app/lib/src/features/quarantine/ = code source Flutter !).
/quarantine/
# Échantillons isolés par le prototype historique : blobs chiffrés + JSON,
# jamais versionnés (binaires suspects, même chiffrés).
docs/legacy-python/quarantine/
# SBOM généré (régénérable : cargo cyclonedx, artefact CI)
core/sbom.json
# Configs personnelles
.vscode/settings.json
